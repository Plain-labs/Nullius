# GitHub Linguist overrides
# Prevents generated/vendor files from skewing language stats

# Lock files — generated, not source
Cargo.lock linguist-generated=true
bun.lock   linguist-generated=true
*.lock     linguist-generated=true

# Snapshot test JSON — generated by soroban test harness
**/test_snapshots/**/*.json linguist-generated=true

# Circuit build outputs
circuits/build/** linguist-generated=true

# Scripts are vendored/tooling, not the primary language
*.sh linguist-detectable=false

# Ensure primary languages are detected correctly
*.rs  linguist-detectable=true
*.ts  linguist-detectable=true
*.tsx linguist-detectable=true
